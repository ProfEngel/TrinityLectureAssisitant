{
  "llm": {
    "use_local": true,
    "local_url": "http://localhost:1234/v1/chat/completions",
    "local_model": "qwen/qwen3.6-35b-a3b",
    "remote_url": "https://openrouter.ai/api/v1/chat/completions",
    "remote_model": "deepseek/deepseek-v4-pro",
    "api_key": "YOUR_OPENROUTER_KEY"
  },
  "apis": {
    "tavily": "YOUR_TAVILY_KEY",
    "fal_ai": "YOUR_FAL_AI_KEY"
  },
  "persona": {
    "agent_name": "Trinity",
    "trigger_variants": ["trinity", "triniti", "trindy", "trinnity", "trinitiy", "trenty", "trendy"]
  },
  "image": {
    "primary_model": "fal-ai/nano-banana-2",
    "fallback_model": "fal-ai/nano-banana-pro"
  },
  "stt": {
    "model": "small",
    "silence_threshold": 0.015,
    "chunk_duration": 2
  },
  "tts": {
    "voice": "Samantha"
  },
  "system": {
    "show_terminal": true,
    "mode": "chat",
    "windows_speech_enabled": false
  },
  "comfyui": {
    "enabled": false,
    "server_url": "http://YOUR_TAILSCALE_NODE:8188",
    "default_workflow": "Flux2_Klein_T2I_API.json"
  },
  "codex": {
    "enabled": false,
    "executable": "codex",
    "default_project": "Automatismen",
    "projects": {
      "Automatismen": "/FULL/PATH/TO/YOUR/AUTOMATION_PROJECT"
    },
    "sandbox": "workspace-write",
    "timeout_seconds": 900,
    "max_output_chars": 3200,
    "ephemeral": true,
    "network_access": false
  }
}
